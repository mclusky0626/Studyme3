# 이 파일을 .env 로 복사한 뒤 값을 채워주세요.

# 디스코드 봇 토큰 (필수) — https://discord.com/developers/applications
DISCORD_TOKEN=

# Gemini API 키 (필수 — 임베딩에 사용, 채팅 모델로도 사용 가능)
# https://aistudio.google.com/apikey 에서 무료 발급
GEMINI_API_KEY=

# (선택) 여러 Gemini 키를 콤마로 나열하면, 앞 키의 무료 한도(429)가 차는 대로
# 자동으로 다음 키로 전환한다. 설정 시 이 목록의 첫 키가 GEMINI_API_KEY보다 우선.
# 예: GEMINI_API_KEYS=AIzaXXXX,AIzaYYYY,AIzaZZZZ
GEMINI_API_KEYS=

# xAI(Grok) API 키 (선택 — Grok으로 채팅하고 싶을 때)
# https://console.x.ai 에서 발급
XAI_API_KEY=

# OpenAI(GPT) API 키 (선택 — GPT로 채팅하고 싶을 때, 유료)
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=

# 봇 호명어 (이 단어로 시작하면 봇이 응답)
WAKE_WORD=제비야

# 기본 채팅 모델 제공자: gemini | grok | openai
LLM_PROVIDER=gemini

# 접두사 없는 메시지에 봇이 끼어들지 판단하는 방식: ollama | cloud | off
#   ollama = 로컬 경량 모델로 무료 판단(권장). 먼저 `ollama pull gemma2:2b` 필요.
#   cloud  = 메인 LLM으로 판단(토큰 소모) / off = LLM 없이 로컬 규칙만(애매하면 안 끼어듦)
ENGAGE_JUDGE=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_JUDGE_MODEL=gemma2:2b

# 모델 이름 (기본값 그대로 둬도 됨)
GEMINI_MODEL=gemini-2.5-flash
GROK_MODEL=grok-3
OPENAI_MODEL=gpt-4o
EMBED_MODEL=gemini-embedding-001
